    "/listings": {
      "get": {
        "operationId": "ListingsController_list",
        "parameters": [
          {
            "name": "district",
            "required": false,
            "in": "query",
            "schema": {
              "example": "Quan 7",
              "type": "string"
            }
          },
          {
            "name": "keyword",
            "required": false,
            "in": "query",
            "schema": {
              "example": "studio ban cong",
              "type": "string"
            }
          },
          {
            "name": "minPrice",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "example": 3000000,
              "type": "number"
            }
          },
          {
            "name": "maxPrice",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "example": 9000000,
              "type": "number"
            }
          },
          {
            "name": "minArea",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "example": 25,
              "type": "number"
            }
          },
          {
            "name": "petAllowed",
            "required": false,
            "in": "query",
            "schema": {
              "example": true,
              "type": "boolean"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "example": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Listings"
        ]
      }
    },
