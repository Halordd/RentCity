  "info": {
    "title": "RentCity Backend API",
    "description": "REST API contract for RentCity web, mobile app, and phone-based web app clients.",
    "version": "0.2.9",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local development"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RequestOtpDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+84912345678",
            "description": "Vietnam phone number used for OTP login."
          }
        },
        "required": [
          "phone"
        ]
      },
      "VerifyOtpDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+84912345678"
          },
          "code": {
            "type": "string",
            "example": "123456",
            "minLength": 6,
            "maxLength": 6
          }
        },
        "required": [
          "phone",
          "code"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "rc_refresh_session_secret"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "example": "Nguyen Van An",
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "example": "tenant@rentcity.vn"
          },
          "preferredArea": {
            "type": "string",
            "example": "Quan 7",
            "maxLength": 120
          }
        }
      },
      "CreateBookingDto": {
        "type": "object",
        "properties": {
          "listingId": {
            "type": "string",
            "example": "studio-nguyen-van-cu"
          },
          "date": {
            "type": "string",
            "example": "2026-07-04",
            "format": "date"
          },
          "timeSlot": {
            "type": "string",
            "example": "14:30 - 16:00"
          },
          "note": {
            "type": "string",
            "example": "Can I view this listing after work?"
          }
        },
        "required": [
          "listingId",
          "date",
          "timeSlot"
        ]
      },
      "RescheduleBookingDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "example": "2026-07-05",
            "format": "date"
          },
          "timeSlot": {
            "type": "string",
            "example": "09:00 - 11:00"
          }
        },
        "required": [
          "date",
          "timeSlot"
        ]
      },
      "UpdateAppStateDto": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "object",
            "example": {
              "activeTab": "saved",
              "filters": {
                "district": "Quan 7"
              }
            }
          }
        },
        "required": [
          "payload"
        ]
      },
      "CreatePushSubscriptionDto": {
        "type": "object",
        "properties": {
          "endpoint": {
            "type": "string",
            "example": "https://push.example/subscription/abc"
          },
          "keys": {
            "type": "object",
            "example": {
              "p256dh": "public-key",
              "auth": "auth-secret"
            }
          }
        },
        "required": [
          "endpoint",
          "keys"
        ]
      },
      "CreateConversationDto": {
        "type": "object",
        "properties": {
          "listingId": {
            "type": "string",
            "example": "studio-nguyen-van-cu"
          },
          "ownerId": {
            "type": "string",
            "example": "owner-minh"
          }
        },
        "required": [
          "ownerId"
        ]
      },
      "CreateMessageDto": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string",
            "example": "Can I visit this room tomorrow?",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "body"
        ]
      },
      "CreateDepositDto": {
        "type": "object",
        "properties": {
          "listingId": {
            "type": "string",
            "example": "studio-nguyen-van-cu"
          },
          "amount": {
            "type": "number",
            "example": 1000000,
            "minimum": 1
          },
          "provider": {
            "type": "string",
            "example": "local"
          }
        },
        "required": [
          "listingId",
          "amount"
        ]
      },
      "PaymentWebhookDto": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "example": "rc_1719820000_abcd1234"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "PROCESSING",
              "PAID",
              "FAILED",
              "REFUNDED"
            ],
            "example": "PAID"
          },
          "amount": {
            "type": "number",
            "example": 1000000,
            "minimum": 1
          },
          "provider": {
            "type": "string",
            "example": "payos"
          },
          "eventId": {
            "type": "string",
            "example": "payos:event:123"
          }
        },
        "required": [
          "reference",
          "status"
        ]
      },
      "CreateContractDto": {
        "type": "object",
        "properties": {
          "listingId": {
            "type": "string",
            "example": "studio-nguyen-van-cu"
          },
          "fileUrl": {
            "type": "string",
            "example": "https://cdn.rentcity.vn/contracts/contract-123.pdf"
          }
        },
        "required": [
          "listingId"
        ]
      },
      "CreateOwnerListingDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Studio Nguyen Van Cu"
          },
          "description": {
            "type": "string",
            "example": "Bright studio with balcony and full furniture."
          },
          "address": {
            "type": "string",
            "example": "123 Nguyen Van Cu"
          },
          "district": {
            "type": "string",
            "example": "Quan 7"
          },
          "city": {
            "type": "string",
            "example": "Ho Chi Minh City"
          },
          "price": {
            "type": "number",
            "example": 5800000,
            "minimum": 0
          },
          "deposit": {
            "type": "number",
            "example": 5800000,
            "minimum": 0
          },
          "area": {
            "type": "number",
            "example": 28,
            "minimum": 1
          },
          "bedrooms": {
            "type": "number",
            "example": 1,
            "minimum": 0
          },
          "bathrooms": {
            "type": "number",
            "example": 1,
            "minimum": 0
          },
          "floor": {
            "type": "string",
            "example": "Tang 5"
          },
          "electricityFee": {
            "type": "string",
            "example": "4k/kWh"
          },
          "waterFee": {
            "type": "string",
            "example": "100k/month"
          },
          "parkingFee": {
            "type": "string",
            "example": "150k/month"
          },
          "petAllowed": {
            "type": "boolean",
            "example": true
          },
          "amenities": {
            "example": [
              "May lanh",
              "Ban cong"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "title",
          "description",
          "address",
          "district",
          "price",
          "area"
        ]
      },
      "UpdateOwnerListingDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Studio Nguyen Van Cu"
          },
          "description": {
            "type": "string",
            "example": "Bright studio with balcony and full furniture."
          },
          "address": {
            "type": "string",
            "example": "123 Nguyen Van Cu"
          },
          "district": {
            "type": "string",
            "example": "Quan 7"
          },
          "city": {
            "type": "string",
            "example": "Ho Chi Minh City"
          },
          "price": {
            "type": "number",
            "example": 5800000,
            "minimum": 0
          },
          "deposit": {
            "type": "number",
            "example": 5800000,
            "minimum": 0
          },
          "area": {
            "type": "number",
            "example": 28,
            "minimum": 1
          },
          "bedrooms": {
            "type": "number",
            "example": 1,
            "minimum": 0
          },
          "bathrooms": {
            "type": "number",
            "example": 1,
            "minimum": 0
          },
          "floor": {
            "type": "string",
            "example": "Tang 5"
          },
          "electricityFee": {
            "type": "string",
            "example": "4k/kWh"
          },
          "waterFee": {
            "type": "string",
            "example": "100k/month"
          },
          "parkingFee": {
            "type": "string",
            "example": "150k/month"
          },
          "petAllowed": {
            "type": "boolean",
            "example": true
          },
          "amenities": {
            "example": [
              "May lanh",
              "Ban cong"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AddListingImageDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "example": "https://images.rentcity.vn/studio-1.jpg"
          },
          "alt": {
            "type": "string",
            "example": "Bedroom with large window"
          },
          "sortOrder": {
            "type": "number",
            "example": 0,
            "minimum": 0
          }
        },
        "required": [
          "url"
        ]
      },
      "CreateImageUploadIntentDto": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "example": "studio-bedroom.jpg"
          },
          "contentType": {
            "type": "string",
            "example": "image/jpeg"
          },
          "sizeBytes": {
            "type": "number",
            "example": 512000,
            "minimum": 1,
            "maximum": 10485760
          },
          "alt": {
            "type": "string",
            "example": "Bedroom photo"
          },
          "sortOrder": {
            "type": "number",
            "example": 1,
            "minimum": 0
          }
        },
        "required": [
          "filename",
          "contentType",
          "sizeBytes"
        ]
      },
      "ReviewListingDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PENDING_REVIEW",
              "PUBLISHED",
              "PAUSED",
              "REJECTED"
            ],
            "example": "PUBLISHED"
          },
          "note": {
            "type": "string",
            "example": "Photos and pricing look valid."
          }
        },
        "required": [
          "status"
        ]
      },
      "UpdateDisputeDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "IN_REVIEW",
              "RESOLVED",
              "REJECTED"
            ],
            "example": "RESOLVED"
          },
          "note": {
            "type": "string",
            "example": "Resolved after contacting both sides."
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
