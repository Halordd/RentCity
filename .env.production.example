# RentCity Production Environment Configuration
# Copy this file to .env.production and fill in real values before deploying.

# --- Core ---
NODE_ENV=production
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/rentcity?schema=public
REDIS_URL=redis://redis:6379
PORT=4000
BACKEND_PORT=4000
FRONTEND_PORT=8080

# --- Auth ---
JWT_SECRET=CHANGE_ME_to_a_long_random_string
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_TTL_DAYS=30

# --- CORS ---
FRONTEND_ORIGINS=https://rentcity.test

# --- API Docs ---
# Set to "true" to expose Swagger UI in production (not recommended)
API_DOCS_ENABLED=false

# --- OTP ---
OTP_TTL_SECONDS=300
OTP_REQUEST_LIMIT_PER_HOUR=5

# --- Payment Webhook ---
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_to_a_random_string

# --- SMS Provider ---
# Options: local, twilio, zalo
SMS_PROVIDER=local

# Twilio (required when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Zalo ZNS (required when SMS_PROVIDER=zalo)
ZALO_ZNS_ACCESS_TOKEN=
ZALO_ZNS_OTP_TEMPLATE_ID=
ZALO_ZNS_TEXT_TEMPLATE_ID=

# --- Payment Provider ---
# Options: local, payos, momo, vnpay
PAYMENT_PROVIDER=local
LOCAL_PAYMENT_CHECKOUT_BASE_URL=http://localhost:4000/pay

# PayOS (required when PAYMENT_PROVIDER=payos)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=https://rentcity.test/payments/return
PAYOS_CANCEL_URL=https://rentcity.test/payments/cancel

# MoMo (required when PAYMENT_PROVIDER=momo)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_RETURN_URL=https://rentcity.test/payments/return
MOMO_IPN_URL=https://rentcity.test/payments/webhook/momo

# VNPay (required when PAYMENT_PROVIDER=vnpay)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=https://rentcity.test/payments/return

# --- Storage Provider ---
# Options: local, s3
STORAGE_PROVIDER=local
UPLOAD_PUBLIC_BASE_URL=http://localhost:4000/uploads

# S3-compatible (required when STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_REGION=ap-southeast-1
# Optional custom endpoint for R2/MinIO/etc
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://cdn.rentcity.test/uploads
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_EXPIRES_SECONDS=600
# Optional: AES256 or aws:kms
S3_SERVER_SIDE_ENCRYPTION=
S3_PRIVATE_READ_EXPIRES_SECONDS=300

# --- Geocoding Provider ---
# Options: local, google, nominatim
MAP_PROVIDER=local

# Google Maps (required when MAP_PROVIDER=google)
GOOGLE_MAPS_API_KEY=

# Nominatim/OpenStreetMap (required when MAP_PROVIDER=nominatim)
NOMINATIM_CONTACT_EMAIL=admin@rentcity.test

# --- Email Provider ---
# Options: local, resend
EMAIL_PROVIDER=local

# Resend (required when EMAIL_PROVIDER=resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@rentcity.test

# --- Push Notification Provider ---
# Options: local, web-push
PUSH_PROVIDER=local

# Web Push / VAPID (required when PUSH_PROVIDER=web-push)
VAPID_SUBJECT=mailto:admin@rentcity.test
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:4000

# --- Database (for docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=rentcity
