COMPOSE_PROJECT_NAME=rentcity

# Public URLs
FRONTEND_PUBLIC_URL=http://localhost:8080
BACKEND_PUBLIC_URL=http://localhost:4000
VITE_API_BASE_URL=http://localhost:4000

# Frontend
FRONTEND_PORT=8080

# Backend
BACKEND_PORT=4000
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://rentcity:change-db-password@postgres:5432/rentcity?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_TTL_DAYS=30
FRONTEND_ORIGINS=http://localhost:8080
API_DOCS_ENABLED=false
OTP_TTL_SECONDS=300
OTP_REQUEST_LIMIT_PER_HOUR=5
SMS_PROVIDER=local
PAYMENT_PROVIDER=local
STORAGE_PROVIDER=local
PAYMENT_WEBHOOK_SECRET=replace-with-payment-webhook-secret
LOCAL_PAYMENT_CHECKOUT_BASE_URL=http://localhost:4000/payments/local-checkout
UPLOAD_PUBLIC_BASE_URL=http://localhost:4000/uploads
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_EXPIRES_SECONDS=600

# PostgreSQL
POSTGRES_USER=rentcity
POSTGRES_PASSWORD=change-db-password
POSTGRES_DB=rentcity
